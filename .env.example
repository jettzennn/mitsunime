# Mitsunime — contoh konfigurasi.
# Salin ke .env lalu isi nilainya. JANGAN commit file .env berisi rahasia.
# JANGAN masukkan .env ke dalam zip deploy.

# Port dan host server (default: 3000, 0.0.0.0)
PORT=3000
HOST=0.0.0.0

# Alamat publik situs ini, dipakai tautan di surat (mis. reset password).
# Default http://localhost:3000 untuk Termux. Isi alamat publik bila
# situs di-hosting (mis. https://mitsunime.contoh).
BASE_URL=http://localhost:3000

# Lokasi file database SQLite (default: data/mitsunime.db)
DB_PATH=data/mitsunime.db

# Base URL API Anikoto (tanpa garis miring di akhir).
# Ganti bila domain API berubah.
ANIKOTO_BASE_URL=https://anikotoapi.site

# RAHASIA — alamat dashboard admin tersembunyi.
# Format contoh: /a-<kata acak panjang, mis. 16+ karakter huruf+angka>
# Isi nilai ASLI hanya di file .env di HP kamu — JANGAN tulis nilai asli
# di file contoh ini, di chat, atau di file apa pun yang dibagikan/dizip,
# karena siapa pun yang tahu alamat ini tinggal menghadapi password admin
# saja. Bila kosong, rute admin tidak hidup sama sekali.
# Tidak ada tautan publik ke alamat ini di situs mana pun.
ADMIN_PATH=

# --- Auto-seed admin (v1.3.0) ---
# Bila keduanya terisi dan belum ada admin, server membuat akun admin
# dari nilai ini saat pertama start — supaya tidak perlu menjalankan
# seed-admin.js manual di tiap instalasi. Bila sudah ada admin, nilai
# ini diabaikan (satu admin saja).
# ADMIN_USER bukan rahasia (default: faygo). ADMIN_PASS KOSONG di sini
# dan HARUS diisi sekali di .env di HP — jangan pernah kirim password
# lewat chat, jangan tulis password asli ke file apa pun yang dibagikan.
ADMIN_USER=faygo
ADMIN_PASS=

# --- Pembayaran premium ---
# Cara bayar UTAMA: MANUAL QRIS (default). Admin mengunggah gambar kode
# QRIS lewat dashboard ({ADMIN_PATH}/api/settings/qris); pembeli membayar
# dengan memindai kode itu di aplikasi pembayarannya, lalu admin menyetujui
# setelah memeriksa bukti bayar + mutasi. Tidak butuh kunci apa pun.
# Midtrans tetap tersedia sebagai OPSI (adapter sudah ada): bila dipakai,
# isi kunci di bawah (mode Sandbox). Kunci Midtrans OPSIONAL — bila kosong,
# alur Midtrans menolak dengan 503, tetapi alur manual QRIS tetap jalan.
# Pengaturan cara bayar default (manual/midtrans) ada di tabel settings
# (kunci payment_gateway) dan bisa diubah admin dari dashboard.
PAYMENT_GATEWAY=midtrans
# v1.3.0: default false (produksi) karena kunci pengguna adalah kunci
# Production (Mid-server-). Ganti ke true bila memakai kunci Sandbox
# (SB-Mid-server-). Nilai ini HARUS cocok dengan jenis kunci, kalau
# tidak Midtrans menolak dengan 401.
MIDTRANS_SANDBOX=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# --- Verifikasi email OTP (v1.3.0, OPSIONAL) ---
# Bila ketiganya diisi, pendaftaran mengirim OTP 6 digit (berlaku
# 1 menit) dan login ditolak sampai email terverifikasi. Bila kosong,
# verifikasi NONAKTIF dan register/login jalan seperti biasa.
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=
# alamat Gmail kamu, SMTP_PASS=App Password Gmail (bukan password biasa
# — butuh 2FA aktif di akun Google itu). SMTP_FROM boleh kosong
# (dipakai SMTP_USER). JANGAN pernah kirim isi .env ke siapa pun.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Terjemahan sinopsis + subtitle (OPSIONAL): alamat email untuk parameter
# &de= MyMemory — BUKAN kunci/API key, hanya menaikkan kuota gratis harian
# dari 5.000 menjadi 50.000 karakter. Kosong = anonim (kuota dipakai bersama
# per IP, bisa habis). Isi dengan email Anda sendiri bila kuota anonim
# sering habis; Google Translate tetap dicoba dulu tanpa email apa pun.
# Dipakai sinopsis (server-side) DAN subtitle Indonesia (client-side,
# v1.5.0 — fallback translate di browser penonton).
MYMEMORY_EMAIL=

# Cookie sesi: aktifkan Secure HANYA bila situs sudah HTTPS.
# Di localhost HTTP (Termux) harus false, kalau tidak cookie tidak tersimpan.
COOKIE_SECURE=false
# Nama cookie sesi admin (v1.3.1): BERBEDA dari cookie sesi user supaya
# login admin tidak menimpa sesi user biasa di browser yang sama.
ADMIN_COOKIE_NAME=mitsunime_admin_session

# TTL cache (detik): recent 15 menit, series 1 jam.
RECENT_TTL_SECONDS=900
SERIES_TTL_SECONDS=3600

# Batas pagination API sendiri (lindungi server HP).
MAX_PER_PAGE=50
DEFAULT_PER_PAGE=20

# Jumlah halaman yang disapu sekali jalan seed (per_page=100).
SEED_PAGES=50
